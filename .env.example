# FH5 遥测分析系统 - 环境变量配置模版

# ============================================================
# AI 智能体接入配置（可选，不填则基础遥测与语音播报照常可用）
# ============================================================
# 本项目使用标准 OpenAI 兼容协议，可直接接入任意主流大模型服务商。
# 优先级：AI_* > OPENAI_* > DASHSCOPE_*（旧版百炼变量仍然完全兼容）
#
# 常见服务商参考（在页面右上角设置面板的「AI 配置」中也有一键预设）：
#   DeepSeek       AI_BASE_URL=https://api.deepseek.com/v1              AI_MODEL=deepseek-chat
#   OpenAI         AI_BASE_URL=https://api.openai.com/v1                AI_MODEL=gpt-4o
#   阿里云百炼     AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen3.7-plus
#   硅基流动       AI_BASE_URL=https://api.siliconflow.cn/v1            AI_MODEL=deepseek-ai/DeepSeek-V3
#   月之暗面 Kimi  AI_BASE_URL=https://api.moonshot.cn/v1               AI_MODEL=moonshot-v1-8k
#   Ollama 本地    AI_BASE_URL=http://localhost:11434/v1                AI_MODEL=qwen2.5:14b（密钥可留空）
#   自定义中转     AI_BASE_URL=https://your-gateway.example.com/v1      AI_MODEL=your-model-id

AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.7-plus

# ------------------------------------------------------------
# 旧版阿里云百炼变量（保留以兼容已有配置，无需手动迁移）
# ------------------------------------------------------------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus

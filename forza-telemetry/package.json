{
  "name": "forza-telemetry",
  "version": "1.0.0",
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "start": "cd server && npm start",
    "server": "cd server && npm run dev",
    "build:client": "cd client && npm run build",
    "test:client": "cd client && npm test",
    "test:server": "cd server && npm test",
    "lint:dead": "cd client && npm run lint:dead",
    "verify": "npm run test:server && npm run test:client && npm run build:client",
    "test": "cd server && node src/test-sender.js",
    "build:map": "python3 scripts/generate_codemap.py",
    "rebuild:tracks": "node scripts/rebuild_tracks.mjs",
    "normalize:data": "node scripts/normalize_runtime_data.mjs --apply"
  }
}
